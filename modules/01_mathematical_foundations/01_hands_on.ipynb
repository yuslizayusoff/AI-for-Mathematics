# SECTION 7: DERIVATIVES AND SLOPES
# ==================================

# Function: f(x) = x^2
# Derivative: f'(x) = 2x

x = np.linspace(-3, 3, 100)
y = x**2
dy_dx = 2*x

plt.figure(figsize=(10, 4))

plt.subplot(1, 2, 1)
plt.plot(x, y, 'b-', label='f(x) = x²')
plt.scatter([1, 2], [1, 4], color='r', s=100, zorder=5)
plt.plot([1, 1], [0, 1], 'r--', alpha=0.5)
plt.plot([2, 2], [0, 4], 'r--', alpha=0.5)
plt.grid(True)
plt.xlabel('x')
plt.ylabel('f(x)')
plt.title('Function f(x) = x²')
plt.legend()

plt.subplot(1, 2, 2)
plt.plot(x, dy_dx, 'g-', label="f'(x) = 2x")
plt.scatter([1, 2], [2, 4], color='r', s=100, zorder=5)
plt.grid(True)
plt.xlabel('x')
plt.ylabel("f'(x)")
plt.title('Derivative f\'(x) = 2x')
plt.legend()

plt.tight_layout()
plt.show()

# Calculate derivative at specific points
print("Derivative at different points:")
for x_val in [-2, -1, 0, 1, 2]:
    derivative = 2 * x_val
    print(f"f'({x_val}) = {derivative}")

