# SECTION 3: DOT PRODUCT
# ======================

# Dot product (element-wise multiplication then sum)
a = np.array([1, 2, 3])
b = np.array([4, 5, 6])

dot_product = np.dot(a, b)
print(f"a · b = {dot_product}")
print(f"Calculation: 1*4 + 2*5 + 3*6 = {1*4 + 2*5 + 3*6}")

# Dot product measures similarity
# Perpendicular vectors: dot product = 0
perp1 = np.array([1, 0])
perp2 = np.array([0, 1])
print(f"\nPerpendicular vectors dot product: {np.dot(perp1, perp2)}")

# Parallel vectors: dot product = large
parallel1 = np.array([1, 1])
parallel2 = np.array([2, 2])
print(f"Parallel vectors dot product: {np.dot(parallel1, parallel2)}")

# Real-world example: Movie recommendation
print("\n--- Movie Recommendation Example ---")
customer_preference = np.array([9, 8, 3])  # likes action, sci-fi, not drama
movie_quality = np.array([8, 7, 2])       # high action, high sci-fi, low drama

recommendation_score = np.dot(customer_preference, movie_quality)
print(f"Recommendation score: {recommendation_score}")
print("High score = customer will like this movie!")

