# SECTION 4: VECTOR NORM (MAGNITUDE)
# ===================================

# L2 norm (Euclidean distance)
v = np.array([3, 4])
norm_manual = np.sqrt(3**2 + 4**2)
norm_numpy = np.linalg.norm(v)

print(f"Vector v: {v}")
print(f"Norm (manual): {norm_manual}")
print(f"Norm (NumPy): {norm_numpy}")

# Normalize vector (make it unit length)
v_normalized = v / norm_numpy
print(f"Normalized v: {v_normalized}")
print(f"Norm of normalized v: {np.linalg.norm(v_normalized)}")

# Visualization
fig, ax = plt.subplots(1, 1, figsize=(8, 8))
ax.quiver(0, 0, v[0], v[1], angles='xy', scale_units='xy', scale=1, color='r', label=f'v (length={norm_numpy:.2f})')
ax.quiver(0, 0, v_normalized[0], v_normalized[1], angles='xy', scale_units='xy', scale=1, color='b', label='v_normalized (length=1)')
ax.set_xlim(-1, 5)
ax.set_ylim(-1, 5)
ax.grid(True)
ax.legend()
ax.set_title('Vector Normalization')
plt.show()

