# FINAL PROJECT: Build a Simple Linear Regression
# ================================================

# Generate sample data
np.random.seed(42)
X = np.random.randn(50, 1) * 3
y = 2*X + 1 + np.random.randn(50, 1) * 2  # y = 2x + 1 + noise

# Initialize weights randomly
w = np.random.randn(1, 1) * 0.01
b = 0.0
learning_rate = 0.01
iterations = 100

# Gradient descent
losses = []
for i in range(iterations):
    # Forward pass
    predictions = X @ w + b
    
    # Compute loss (MSE)
    loss = np.mean((predictions - y)**2)
    losses.append(loss)
    
    # Backward pass (compute gradients)
    dw = 2 * np.mean((predictions - y) * X)
    db = 2 * np.mean(predictions - y)
    
    # Update weights
    w = w - learning_rate * dw
    b = b - learning_rate * db
    
    if i % 20 == 0:
        print(f"Iteration {i}: Loss = {loss:.4f}, w = {w[0,0]:.4f}, b = {b:.4f}")

# Visualize results
plt.figure(figsize=(12, 4))

plt.subplot(1, 2, 1)
plt.scatter(X, y, color='blue', alpha=0.6, label='Data')
x_line = np.array([-3, 3]).reshape(-1, 1)
y_line = x_line @ w + b
plt.plot(x_line, y_line, 'r-', linewidth=2, label=f'Learned: y = {w[0,0]:.2f}x + {b:.2f}')
plt.xlabel('x')
plt.ylabel('y')
plt.title('Linear Regression Result')
plt.legend()
plt.grid(True)

plt.subplot(1, 2, 2)
plt.plot(losses, 'g-', linewidth=2)
plt.xlabel('Iteration')
plt.ylabel('Loss (MSE)')
plt.title('Loss Over Time')
plt.grid(True)

plt.tight_layout()
plt.show()

print(f"\nFinal weights:")
print(f"w = {w[0,0]:.4f} (true value ≈ 2)")
print(f"b = {b:.4f} (true value ≈ 1)")

