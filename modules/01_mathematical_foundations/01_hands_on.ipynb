# SECTION 8: GRADIENTS (MULTIVARIABLE DERIVATIVES)
# ================================================

# Function: f(x, y) = x^2 + y^2
# Gradient: ∇f = [2x, 2y]

x = np.linspace(-3, 3, 20)
y = np.linspace(-3, 3, 20)
X, Y = np.meshgrid(x, y)
Z = X**2 + Y**2

# Calculate gradients
dZ_dx = 2*X
dZ_dy = 2*Y

# Visualize
fig = plt.figure(figsize=(12, 5))

ax1 = fig.add_subplot(1, 2, 1, projection='3d')
ax1.plot_surface(X, Y, Z, cmap='viridis', alpha=0.7)
ax1.set_xlabel('x')
ax1.set_ylabel('y')
ax1.set_zlabel('f(x,y)')
ax1.set_title('Function f(x,y) = x² + y²')

ax2 = fig.add_subplot(1, 2, 2)
ax2.contourf(X, Y, Z, levels=20, cmap='viridis')
ax2.quiver(X, Y, dZ_dx, dZ_dy, alpha=0.6)
ax2.set_xlabel('x')
ax2.set_ylabel('y')
ax2.set_title('Gradient Field (arrows point uphill)')
plt.colorbar(ax2.contourf(X, Y, Z, levels=20, cmap='viridis'), ax=ax2)

plt.tight_layout()
plt.show()

# Gradient at specific point
x_point, y_point = 1, 2
gradient = np.array([2*x_point, 2*y_point])
print(f"At point ({x_point}, {y_point}): gradient = {gradient}")
print("This vector points in the steepest uphill direction!")

