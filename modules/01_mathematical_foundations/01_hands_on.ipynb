# SECTION 10: CHAIN RULE
# ======================

# Example: y = (2x + 3)^2
# Using chain rule: dy/dx = 2(2x+3) * 2 = 4(2x+3)

def f(x):
    u = 2*x + 3
    return u**2

def df_numerical(x, h=0.0001):
    return (f(x + h) - f(x - h)) / (2*h)

def df_analytical(x):
    return 4*(2*x + 3)

# Test at different points
print("Chain Rule Example: y = (2x + 3)²")
print("\nComparison of numerical vs analytical derivatives:")
print(f"{'x':<10} {'Numerical':<15} {'Analytical':<15} {'Difference':<15}")
print("-" * 55)

for x_val in [-2, -1, 0, 1, 2]:
    numerical = df_numerical(x_val)
    analytical = df_analytical(x_val)
    diff = abs(numerical - analytical)
    print(f"{x_val:<10} {numerical:<15.6f} {analytical:<15.6f} {diff:<15.6e}")

# Visualize
x = np.linspace(-2, 2, 100)
y = f(x)
dy_dx = df_analytical(x)

plt.figure(figsize=(10, 4))

plt.subplot(1, 2, 1)
plt.plot(x, y, 'b-', linewidth=2, label='f(x) = (2x+3)²')
plt.grid(True)
plt.xlabel('x')
plt.ylabel('f(x)')
plt.title('Function')
plt.legend()

plt.subplot(1, 2, 2)
plt.plot(x, dy_dx, 'g-', linewidth=2, label="f'(x) = 4(2x+3)")
plt.grid(True)
plt.xlabel('x')
plt.ylabel("f'(x)")
plt.title('Derivative (Chain Rule)')
plt.legend()

plt.tight_layout()
plt.show()

