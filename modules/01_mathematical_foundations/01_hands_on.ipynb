# SECTION 9: GRADIENT DESCENT
# ============================

# Problem: Minimize f(x) = (x - 3)^2
# Solution: Use gradient descent

def f(x):
    return (x - 3)**2

def df_dx(x):
    return 2*(x - 3)

# Starting point
x = -1
learning_rate = 0.1
iterations = 20

# Store history for visualization
history = [x]
loss_history = [f(x)]

# Gradient descent loop
for i in range(iterations):
    gradient = df_dx(x)
    x = x - learning_rate * gradient
    history.append(x)
    loss_history.append(f(x))
    
    if i < 5 or i % 5 == 0:
        print(f"Iteration {i}: x = {x:.4f}, f(x) = {f(x):.4f}, gradient = {gradient:.4f}")

# Visualize the optimization path
x_range = np.linspace(-2, 5, 100)
y_range = f(x_range)

plt.figure(figsize=(12, 4))

plt.subplot(1, 2, 1)
plt.plot(x_range, y_range, 'b-', linewidth=2, label='f(x) = (x-3)²')
plt.plot(history, loss_history, 'ro-', markersize=8, linewidth=2, label='Gradient descent path')
plt.scatter([3], [0], color='g', s=200, marker='*', label='Minimum', zorder=5)
plt.xlabel('x')
plt.ylabel('f(x)')
plt.title('Gradient Descent Optimization')
plt.legend()
plt.grid(True)

plt.subplot(1, 2, 2)
plt.plot(loss_history, 'r-o', linewidth=2)
plt.xlabel('Iteration')
plt.ylabel('Loss f(x)')
plt.title('Loss Decrease Over Time')
plt.grid(True)

plt.tight_layout()
plt.show()

print(f"\nFinal x: {x:.4f}")
print(f"Minimum at x: 3.0")
print(f"Converged: {abs(x - 3) < 0.01}")

