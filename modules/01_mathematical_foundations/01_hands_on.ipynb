# Manual calculation
print(f"\nManual calculation:")
print(f"First element: 1*1 + 2*2 = {1*1 + 2*2}")
print(f"Second element: 3*1 + 4*2 = {3*1 + 4*2}")
print(f"Third element: 5*1 + 6*2 = {5*1 + 6*2}")

# Matrix-matrix multiplication
A = np.array([[1, 2],
              [3, 4]])
B = np.array([[5, 6],
              [7, 8]])

C = A @ B
print(f"\nMatrix A ({A.shape}):\n{A}")
print(f"Matrix B ({B.shape}):\n{B}")
print(f"Result C = A @ B ({C.shape}):\n{C}")

